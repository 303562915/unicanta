# Local-only Supabase credentials / endpoints (never commit)
SUPABASE.local.md

# npm deps for the standalone node backend. `server/node/` only ships its test and source;
# `server/node_modules/` was tracked by mistake because server/.gitignore anchored the path
# as `server/node_modules/` (which resolves to server/server/node_modules/).
node_modules/

# Database project stays local: schema, migrations, fixtures and the deployment notes for it.
# The published repository ships the client and the standalone node backend only.
/server/supabase/
/server/test/
/server/README.md
/.github/workflows/supabase_migrations.yml

# Sticker source files: the copies the app ships live in composeResources/drawable as emo_*.png
/static/

# Working copies made before a risky edit
/backups/

# Session handoff notes (local working memory)
/.dsh-handoff*.md

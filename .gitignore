# Legacy app module build artifacts (module is not part of the build anymore)
app/release/
server/node/telemetry.db
server/node/telemetry.db-journal

# Scratch space for translating the bloat list (tools/bloat_descriptions.py)
/.bloat-work/

# Local-only Supabase credentials / endpoints (never commit)
SUPABASE.local.md

# npm deps for the standalone node backend. `server/node/` only ships its test and source;
# `server/node_modules/` was tracked by mistake because server/.gitignore anchored the path
# as `server/node_modules/` (which resolves to server/server/node_modules/).
node_modules/

# Database project stays local: schema, migrations, fixtures and the deployment notes for it.
# The published repository ships the client and the standalone node backend only.
# Migrations are applied by hand over the Management API -- there is no CI workflow for them
# (see AGENTS.md section 10); the old supabase_migrations.yml no longer exists.
/server/supabase/
/server/test/
/server/README.md

# Sticker source files: the copies the app ships live in composeResources/drawable as emo_*.png
/static/

# Working copies made before a risky edit
/backups/

# Scratch output from image/OCR probing at the repo root (.tmp-*.png/.jpg/.py): never shipped.
/.tmp-*
# Script caches
__pycache__/

# Session handoff notes (local working memory)
/.dsh-handoff*.md

# Internal ops notes / incident postmortems (local only, like /backups/).
# These carry the real architecture, credentials-adjacent detail and traffic numbers;
# they stay on the machine that operates the backend and never ship with the client.
/ops-notes/

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="rikka.shizuku" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- The switch HyperOS/MIUI/ColorOS put on top of QUERY_ALL_PACKAGES. Unlike their other
         switches this one is a real runtime permission and can be requested (same approach as
         FlClash); ROMs without it simply never grant or ask for it. -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 起通知是运行时权限。不给的话新消息只在 app 里计数，通知栏什么也不弹；
         申请入口在设置的「消息通知」开关上（见 AndroidCantaPlatform.requestNotifyPermission）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets analytics (if enabled) report, after a reboot, whether uninstalled packages stayed gone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.leanback"
        android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:logo="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Canta"
        android:name=".CantaApplication"
        tools:targetApi="37">
        <!-- Predictive back is off on purpose. With it on, the system draws the back gesture's
             own transition by shrinking the whole window towards the middle of the screen, and
             that animation runs over whatever the page does — the page always looked like a
             dialog zooming away instead of a page being left. Off, the back gesture is a plain
             back and the page's own transition (fade + slide to the right) is what is seen. -->
        <!-- singleTop：点消息通知要把 intent 送到已经在跑的那一个实例（onNewIntent），
             而不是在它上面再叠一层。没有它，点三条通知要按三次返回才回到原来的页面。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Canta">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 群邀请链接：群设置页复制出去的是 `unicanta://group/<邀请码>`，浏览器/短信/别的
                 app 点它要能回到这个 app。host 固定 group，多一种链接就在这儿多一段 data。
                 不加 autoVerify：那边只对 http(s) 的 App Links 有意义。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unicanta" android:host="group" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- Serves downloaded update APKs to the system installer through a content:// URI it is
             granted read access to; see AndroidCantaPlatform.requestInstall. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

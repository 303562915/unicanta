<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may talk to a telemetry backend on the device itself (127.0.0.1), which needs
     cleartext HTTP; release builds keep the platform default. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
